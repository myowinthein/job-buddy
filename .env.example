# Google Drive OAuth Client ID (required for Cloud Backup)
# Get this from Google Cloud Console → APIs & Services → Credentials
# App type: Web Application (not Chrome Extension). Register https://YOUR_EXTENSION_ID.chromiumapp.org/ as an Authorized Redirect URI in Google Cloud Console. Chrome Extension type will not work with launchWebAuthFlow.
# Create separate client IDs for development and production builds.
# Copy this file to .env.development and .env.production with real values.
# Never commit real client IDs — those files are gitignored.
VITE_GOOGLE_DRIVE_CLIENT_ID=your_google_drive_oauth_client_id_here

# Optional dev-only fallback for the Gemini API key (get one at https://aistudio.google.com/apikey).
# Only used when chrome.storage.local has no saved key AND only in `pnpm dev` builds
# (gated on import.meta.env.DEV) — saves re-pasting a key into Settings every reload.
# Never used in production/zip builds even if set in .env.production. Put this in
# .env.development only.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
