# Copy to .env.development or .env.production. Never commit real values.
# Setup guide https://myowinthein.github.io/job-buddy/developers/#configuration

# Required for Google Drive backup. Use a Web application OAuth client.
# Register https://YOUR_EXTENSION_ID.chromiumapp.org/ as a redirect URI.
# Create separate clients for development and production.
VITE_GOOGLE_DRIVE_CLIENT_ID=your_google_drive_oauth_client_id_here

# Optional Gemini fallback for pnpm dev when no key is saved.
# Set only in .env.development. Ignored by production and zip builds.
# Create a key at https://aistudio.google.com/api-keys
VITE_GEMINI_API_KEY=your_gemini_api_key_here
